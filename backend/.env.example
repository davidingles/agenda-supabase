# ============================================================
# .env.example — Plantilla de variables de entorno
# ============================================================
# CÓMO USARLO:
#   1. Copia este archivo y renómbralo a `.env`
#      (PowerShell:  Copy-Item .env.example .env )
#   2. Sustituye el valor de DATABASE_URL por tu cadena de
#      conexión real de Supabase.
# ============================================================

# Cadena de conexión a PostgreSQL (Supabase).
# La obtienes en: Project Settings -> Database -> Connection string
# (modo "Transaction pooler", puerto 6543, recomendado para apps Node)
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# Puerto donde arranca el servidor Express (opcional, por defecto 3000)
PORT=3000